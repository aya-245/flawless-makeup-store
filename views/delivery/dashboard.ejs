<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@2.0.0-beta.1/dist/leaflet.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/delivery/dashboard.css">
    <script type="importmap">
    {"imports": {"leaflet": "https://cdn.jsdelivr.net/npm/leaflet@2.0.0-beta.1/dist/leaflet.js"}}
    </script>

</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="page">
        <div class="page-header">
            <h1>Delivery Driver Dashboard</h1>
        </div>

        <div class="stats">
            <div class="card stat-card">
                <span class="stat-number"><%= deliveredCount %></span>
                <span class="stat-label">Delivered by me</span>
            </div>
            <div class="card stat-card">
                <span class="stat-number"><%=pendingCount %></span>
                <span class="stst-label">Orders waiting for a driver</span>
            </div>
        </div>

        <h2 class="section-title">My Current Order</h2>

        <% if(currentOrder){ %>
            <div class="delivery-layout">
                <div class="card map-card">
                    <% if (currentOrder.user && currentOrder.user.latitude && currentOrder.user.longitude) { %>
                    <!-- put the customer's location in attributes -->
                        <div id="map" style="height: 400px;"
                        data-lat="<%= currentOrder.user.latitude %>"
                        data-lng="<%= currentOrder.user.longitude %>"></div>
                    <% } else { %>
                        <!-- users who skipped the map have no location -->
                        <p class="no-map">This customer did not choose a location on the map.</p>
                    <% } %>
                </div>
                
                <div class="card delivery-details">
                    <div class="details-top">
                        <h3>Order # <%= currentOrder.orderNumber %></h3>
                        <span class="status status-pending">Out for delivery</span>
                    </div>
                    <div class="detail-row">
                        <span>Customer</span>
                        <span><%= currentOrder.user ? currentOrder.user.username : 'deleted user' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Phone Number</span>
                        <span><%= currentOrder.user ? currentOrder.user.phoneNumber : '' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Address</span>
                        <span><%= currentOrder.user ? currentOrder.user.streetAddress : '' %></span>
                    </div>

                    <h4>Items</h4>
                    <% for(const item of currentOrder.items){ %>
                        <div class="delivery-item">
                            <span><%= item.product ? item.product.name : 'prodcut no longer available' %></span>
                            <span>x <%= item.quantity %></span>
                        </div>
                <% } %>

                <div class="delivery-total">
                    <span>Total</span>
                    <span>BD <%= currentOrder.total %></span>
                </div>

                    <form action="/delivery/<%= currentOrder._id %>?_method=PUT" method="post">
                        <button class="button">Mark as Delivered</button>
                    </form>
                </div>
            </div>

        <% } else { %>
            <div class="card empty-card">
                <p>You have no order to deliver at the moment.</p>
                <% if(pendingCount > 0){ %>
                    <form action="/delivery/next" method="post">
                        <button>Get next order</button>
                    </form>
                <% } else { %>
                    <p class="no-orders">No orders need to be delivered.</p>
                <% } %>
            </div>
        <% } %>

    </main>
    <script type="module">
    import {LeafletMap, TileLayer, Marker, Polyline} from 'leaflet';

    // the map div only exists if the customer has a location, otherwise this is null
    const mapDiv = document.getElementById('map')

    if (mapDiv) {
        // convert data attributes to numbers
        const customerLat = parseFloat(mapDiv.dataset.lat)
        const customerLng = parseFloat(mapDiv.dataset.lng)

        // create the map picked by the customer and increase zoom level to 14
        const map = new LeafletMap('map').setView([customerLat, customerLng], 14)

        // add the openstreet text
        new TileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map)

        // shows the customer's pin for the driver with a popup
        new Marker([customerLat, customerLng]).addTo(map).bindPopup('Customer').openPopup()

        // asks for the driver's permission to get their current location
        navigator.geolocation.getCurrentPosition(function (position) {
        const driverLat = position.coords.latitude
        const driverLng = position.coords.longitude

        // shows the driver's pin on the map
        new Marker([driverLat, driverLng]).addTo(map).bindPopup('You')

        // adds a line between the driver's and customer's location
        new Polyline([[driverLat, driverLng], [customerLat, customerLng]]).addTo(map)

        // zoom the map so it shows both pins
        map.fitBounds([[driverLat, driverLng], [customerLat, customerLng]], { padding: [40, 40] })
        })
    }
    </script>

</body>
</html>