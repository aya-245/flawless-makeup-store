<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>My Orders</h1>
    <% if(orders.length === 0){ %>
        <p>You have no orders yet</p>
    <% } %>

    <% for(const order of orders){ %>
        <div>
            <a href="/orders/<%= order._id %>">Order #<%= order.orderNumber %></a>
            <p>Total: <%= order.total %></p>
            <p><%= order.isDelivered ? 'Delivered' : 'Not Delivered Yet' %></p>
        </div>
    <% } %>
</body>
</html>