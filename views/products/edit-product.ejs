<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Edit Product</h1>
    <form action="/products/<%=product._id %>?_method=PUT" method="post" enctype="multipart/form-data">
         <label for="name">Product Name: </label>
        <input value="<%=product.name%>" type="text" name="name" id="name">

        <label for="description">Product Description: </label>
        <input value="<%=product.description%>" type="text" name="description" id="description">

        <label for="price">Price: </label>
        <input value="<%=product.price%>" type="text" name="price" id="price">

        <label for="category">Product Category: </label>
            <select name="category" id="category">
                <% for(let oneCategory of categories){ %>

                    <option <% if(oneCategory._id.equals(product.category)) {%> selected <% } %>value="<%= oneCategory._id %>"> <%=  oneCategory.categoryName%> </option>
                <% } %>
            </select>
        
        <!-- allows file picker to only show images -->
        <label for="image">Product Image</label>
        <input type="file" name="image" id="image" accept="image/*">
        


        <button>Edit Product</button>
    </form>
</body>
</html>