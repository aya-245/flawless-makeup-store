<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/products/product-details.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <main class="page">
        <a href="/products" class="back-link">Back to Products</a>

        <div class="details-layout">
            <% if(product.image){ %>
                <img class="details-image" src="<%=product.image%>" alt="<%=product.name%>" style="display:block; width:220px; aspect-ratio:1/1; object-fit:cover; border-radius:14px;">
            <% } else {%>
                <div class="details-image"></div>
            <% } %>

            <div class="details-info">
                <% if(product.category){ %>
                    <span class="category"><%= product.category.categoryName %></span>
                <% } %>
                <h1><%= product.name %></h1>
                <p class="details-price">BD <%= product.price %></p>

                <% if(product.description){ %>
                    <p class="details-description"><%= product.description %></p>
                <% } %>

                <div class="details-actions">
                    <a href="/products/<%=product._id%>/edit" class="button">Edit Product</a>

                    <form action="/products/<%= product._id %>?_method=DELETE" method="post">
                        <button class="button">Delete Product</button>
                    </form>
                </div>
            </div>
        </div>
    </main>
</body>
</html>