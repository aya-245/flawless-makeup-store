<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Product Details</h1>

    <p>Product Name: <%= product.name %></p>
    <p>Product Description: <%= product.description %></p>
    <p>Product Price: <%= product.price %></p>
    <p>Product Category: <%= product.category.categoryName %></p>

        <% if(product.image){ %>
            <img src="<%=product.image%>" alt="<%=product.name%>" style="display:block; width:220px; aspect-ratio:1/1; object-fit:cover; border-radius:14px;">
        <% } else {%>
            <div style="display:block; width:220px; aspect-ratio:1/1; background:#f0bcc0; border-radius:14px;"></div>
        <% } %>

    <form action="/products/<%= product._id %>?_method=DELETE" method="post">
        <button>Delete Product</button>
    </form>
    <a href="/products/<%=product._id%>/edit">Edit Product</a>

</body>
</html>