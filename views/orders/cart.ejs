<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Cart</h1>

    <% if (items.length) { %>
        <p>Total: <%= total %></p>

        <form action="/orders" method="POST">
            <button>Checkout</button>
        </form>
    <% } else { %>
        <p>Your cart is empty.</p>
    <% } %>

</body>
</html>