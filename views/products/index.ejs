<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/products/products-index.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="page">
        <div class="page-header">
            <h1>All Products</h1>
            <p class="number-of-products"><%= products.length %> products</p>
        </div>

        <% if(products.length === 0){ %>
            <p class="empty">No products available yet</p>
        <% } %>

        <div class="product-grid">
            <% for(let oneProduct of products){ %>
                <div class="product-card">
                    <% if(oneProduct.image){ %>
                        <img class="product-image" src="<%=oneProduct.image%>" alt="<%=oneProduct.name%>">
                    <% } else {%>
                        <div class="product-image placeholder"></div>
                    <% } %>

                    <div class="product-info">

                        <span class="category-label"><%= oneProduct.category.categoryName %></span>
                        <h3><%= oneProduct.name %></h3>
                        <p class="description"><%= oneProduct.description %></p>

                        <div class="product-bottom">
                            <span class="price">BD <%= oneProduct.price %></span>
                            <a class="button" href="/products/<%= oneProduct._id %>">See Details</a>

                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>