<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>All Products</h1>
    <% for(let oneProduct of products){ %>
        <p>Name: <%= oneProduct.name %></p>
        <a href="/products/<%= oneProduct._id %>">See Details</a>
    <% } %>
</body>
</html>