<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="page">
        <div class="page-header">
            <h1>Admin Dashboard</h1>
            <div class="quick-actions">
                <a class="button" href="/products/new">Add a product</a>
                <a class="button" href="/products">Manage Products</a>
                <a class="button" href="/admin/orders">All Orders</a>
            </div>
        </div>

        <div class="stats">
            <div class="card stat-card">
                <span class="stat-number"><%= productCount %></span>
                <span class="stat-label">Products</span>
            </div>
            
            <div class="card stat-number">
                <span class="stat-number"><%= orderCount %></span>
                <span class="stat-label">Orders</span>
            </div>

            <div class="card stat-number">
                <span class="stat-number"><%= pendingCount %></span>
                <span class="stat-label">Not delivered yet</span>
            </div>
        </div>

        <h2 class="section-title">Recent Orders</h2>

        <% if(recentOrders.length === 0){ %>
            <p class="empty">No orders yet</p>
        <% } else {%>
            <div class="recent-list">
                <% for(const order of recentOrders){ %>
                    <div class="card recent-order">
                        <div class="recent-main">
                            <span class="recent-number"> Order # <%= order.orderNumber %></span>
                            <p>by <%= order.user ? order.user.username : 'deleted user' %></p>
                        </div>
                        <div class="recent-side">
                            <span class="recent-total">BD <%= order.total %></span>
                            <% if(order.isDelivered){ %>
                                <span class="status status-delivered">Delivered</span>
                            <% } else {%>
                                <span class="status status-pending">Not Delivered</span>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </main>
</body>
</html>